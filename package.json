  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/app/server.ts",
    "dev:worker": "tsx watch src/queues/workers/index.ts",
    "debug:api": "node --inspect-brk=9229 --import tsx src/app/server.ts",
    "debug:worker": "node --inspect-brk=9230 --import tsx src/queues/workers/index.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/app/server.js",
    "start:worker": "node dist/queues/workers/index.js",
    "seed": "node dist/infrastructure/database/seed/index.js",
    "seed:build": "npm run build && npm run seed",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "ai:context": "ts-node scripts/generate-ai-context.ts"
  },
