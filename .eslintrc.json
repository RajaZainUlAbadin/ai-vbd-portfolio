{
  "env": {
    "node": true,
    "es2022": true
  },

  "extends": ["eslint:recommended", "plugin:import/recommended", "prettier"],

  "parserOptions": {
    "ecmaVersion": "latest"
  },

  "rules": {
    "import/order": [
      "error",
      {
        "alphabetize": {
          "order": "asc"
        }
      }
    ]
  }
}
